{
 "uid": "claude-code-cost",
 "title": "Claude Code — custo e tokens",
 "schemaVersion": 39,
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "refresh": "1m",
 "panels": [
  {
   "id": 1,
   "title": "Custo no período",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "legend": {
     "displayMode": "table",
     "placement": "right"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(max_over_time(claude_code_cost_usage_USD_total[$__range]))",
     "legendFormat": "",
     "instant": true
    }
   ]
  },
  {
   "id": 2,
   "title": "Tokens no período",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "legend": {
     "displayMode": "table",
     "placement": "right"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(max_over_time(claude_code_token_usage_tokens_total[$__range]))",
     "legendFormat": "",
     "instant": true
    }
   ]
  },
  {
   "id": 3,
   "title": "Cache hit (input)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "legend": {
     "displayMode": "table",
     "placement": "right"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(max_over_time(claude_code_token_usage_tokens_total{type=\"cacheRead\"}[$__range])) / sum(max_over_time(claude_code_token_usage_tokens_total{type=~\"input|cacheRead|cacheCreation\"}[$__range]))",
     "legendFormat": "",
     "instant": true
    }
   ]
  },
  {
   "id": 4,
   "title": "Sessões",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "legend": {
     "displayMode": "table",
     "placement": "right"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(max_over_time(claude_code_session_count_total[$__range]))",
     "legendFormat": "",
     "instant": true
    }
   ]
  },
  {
   "id": 5,
   "title": "Custo por modelo (sessões ativas, janela 1h)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "legend": {
     "displayMode": "table",
     "placement": "right"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model)(max_over_time(claude_code_cost_usage_USD_total[1h]))",
     "legendFormat": "{{model}}",
     "instant": false
    }
   ]
  },
  {
   "id": 6,
